# ==========================================
# IFESPORTE - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ==========================================

# --- BACKEND (Render Web Service) ---
# Porta do servidor (no Render, esta variável é injetada automaticamente)
PORT=7777

# String de conexão com o banco MongoDB (Atlas)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/ifesporte?retryWrites=true&w=majority

# Chave secreta para geração e validação de tokens JWT
JWT_SECRET=sua_chave_secreta_jwt_longa_e_segura

# URL pública do Frontend (para autorização do CORS e links de verificação de e-mail)
CLIENT_URL=https://seu-frontend-ifesporte.onrender.com

# Ambiente de execução (development | production)
NODE_ENV=production

# --- ENVIO DE E-MAIL (SMTP / Nodemailer) ---
# Caso não sejam preenchidas em ambiente local, o sistema exibirá o e-mail e o link no console (modo simulação)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_smtp
EMAIL_FROM=IFesporte <no-reply@ifesporte.edu.br>

# --- FRONTEND (Render Static Site) ---
# URL pública do Backend no Render para onde o frontend enviará as requisições de API
REACT_APP_API_URL=https://seu-backend-ifesporte.onrender.com
